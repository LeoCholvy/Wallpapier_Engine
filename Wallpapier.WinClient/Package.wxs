<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

    <Package Name="Wallpapier" Manufacturer="Wallpapier" Version="1.0.0.0" UpgradeCode="a1b2c3d4-1234-1234-1234-a1b2c3d4e5f6" Scope="perUser">
        <MajorUpgrade DowngradeErrorMessage="Une version plus récente de Wallpapier est déjà installée." />

        <MediaTemplate EmbedCab="yes" />

        <!-- 1. DÉFINITION DES DOSSIERS DE DESTINATION -->

        <!-- Dossier d'installation : C:\Users\Nom\AppData\Local\Wallpapier -->
        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="INSTALLFOLDER" Name="Wallpapier" />
        </StandardDirectory>

        <!-- Dossier pour le Menu Démarrer -->
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="Wallpapier" />
        </StandardDirectory>

        <!-- 2. ACTIVATION DES FONCTIONNALITÉS -->
        <Feature Id="Main">
            <ComponentGroupRef Id="AppComponents" />
            <ComponentRef Id="ApplicationShortcut" />
        </Feature>
    </Package>

    <!-- 3. CONTENU DE L'INSTALLEUR -->
    <Fragment>

        <!-- Les fichiers de l'application -->
        <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
            <Component Id="MainExecutable" Guid="b2c3d4e5-2345-2345-2345-b2c3d4e5f6a7">

                <File Id="WallpapierExe" Source=".\publish_output\Wallpapier.WinClient.exe" KeyPath="yes" />

                <!-- Démarrage automatique avec Windows -->
                <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Wallpapier" Value="[#WallpapierExe]" Type="string" />
            </Component>
        </ComponentGroup>

        <!-- Les raccourcis dans le menu Démarrer -->
        <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="c3d4e5f6-3456-3456-3456-c3d4e5f6a7b8">

            <!-- Raccourci principal pour lancer l'application -->
            <Shortcut Id="AppStartMenuShortcut"
                      Name="Wallpapier"
                      Description="Lancer le client Wallpapier"
                      Target="[#WallpapierExe]"
                      WorkingDirectory="INSTALLFOLDER" />

            <!-- Raccourci de désinstallation (utilise l'outil natif de Windows msiexec) -->
            <Shortcut Id="UninstallProduct"
                      Name="Désinstaller Wallpapier"
                      Description="Désinstalle complètement l'application"
                      Target="[SystemFolder]msiexec.exe"
                      Arguments="/x [ProductCode]" />

            <!-- Nettoyage : Demande à Windows de supprimer le dossier du menu Démarrer à la désinstallation -->
            <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />

            <!-- Obligatoire pour les composants de type "raccourci" : une clé de registre témoin -->
            <RegistryValue Root="HKCU" Key="Software\Wallpapier" Name="ShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
        </Component>

    </Fragment>
</Wix>